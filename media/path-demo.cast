[2.8194, "o", "cat analysis.R\r\n"]
[2.8362, "o", "# Study 1: retrieval practice and recall\r\n# Reported in the paper: t(62) = 2.91, p = .005, d = 0.73\r\n\r\ndat <- read.csv(\"/Users/jasongeller/Dropbox/study1/data_final_v2.csv\")\r\n\r\nres <- t.test(recall ~ condition, data = dat, var.equal = TRUE)\r\nm   <- tapply(dat$recall, dat$condition, mean)\r\nsdp <- sqrt(mean(tapply(dat$recall, dat$condition, var)))\r\n\r\ncat(sprintf(\"t(%d) = %.2f, p = %.3f, d = %.2f\\n\",\r\n            res$parameter, abs(res$statistic), res$p.value,\r\n            (m[\"retrieval\"] - m[\"control\"]) / sdp))\r\n"]
[2.8373, "o", "\u001b[1;32m~/Rix-Nix_Test/path-demo\u001b[0m $ "]
